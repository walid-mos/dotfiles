#!/bin/sh
PATH="/opt/homebrew/bin:$PATH"
export PATH

target=$("$HOME/.config/shims/viewer-host")
[ -n "$target" ] || exec /usr/bin/open "$@"

client="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 $target"
cache=Library/Caches/open-remote
args=
for arg in "$@"; do
	case $arg in
	http://localhost|https://localhost|http://127.0.0.1|https://127.0.0.1|http://localhost[:/?\#]*|https://localhost[:/?\#]*|http://127.0.0.1[:/?\#]*|https://127.0.0.1[:/?\#]*)
		arg=$("$HOME/.config/shims/open-localhost" "$target" "$arg") || exit
		;;
	file://*)
		arg=$(printf '%b' "$(printf '%s' "${arg#file://}" | sed -e 's|^localhost/|/|' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')")
		;;
	esac
	if [ -f "$arg" ]; then
		name=$(basename "$arg")
		$client "mkdir -p $cache && cat > $cache/$(printf '%q' "$name")" < "$arg" || exit
		arg="$cache/$name"
	fi
	args="$args$(printf ' %q' "$arg")"
done
exec $client "exec /usr/bin/open$args"
