#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
developer=$(xcode-select -p 2>/dev/null) || {
    echo 'open tools: install Xcode Command Line Tools before installing these shims. Native open remains /usr/bin/open.' >&2
    exit 2
}
if [ ! -x "$developer/usr/bin/python3" ] && [ ! -x "$developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/python3" ]; then
    echo 'open tools: no real Apple Python interpreter. Repair Command Line Tools. Native open remains /usr/bin/open.' >&2
    exit 2
fi
case ${1:-} in
    open_router|tailnet_link) module=$1; shift ;;
    *) echo 'open tools: unknown entry point' >&2; exit 2 ;;
esac
exec /usr/bin/python3 -I -B "$root/$module.py" "$@"
