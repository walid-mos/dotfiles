// fastfetch — grand logo Apple + infos système. Couleurs ANSI : suivent le thème du terminal.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "macos",
    "padding": {
      "top": 1,
      "left": 3,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    },
    "key": {
      "width": 13
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "  os"
    },
    {
      "type": "host",
      "key": "󰌢  machine"
    },
    {
      "type": "kernel",
      "key": "  kernel"
    },
    {
      "type": "uptime",
      "key": "󰥔  uptime"
    },
    {
      "type": "packages",
      "key": "󰏗  paquets"
    },
    {
      "type": "shell",
      "key": "  shell"
    },
    {
      "type": "display",
      "key": "󰍹  écran",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "cpu",
      "key": "󰻠  cpu",
      "format": "{name} ({cores-physical} cœurs)"
    },
    {
      "type": "memory",
      "key": "󰍛  mémoire"
    },
    {
      "type": "disk",
      "key": "󰋊  disque",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "󰁹  batterie",
      "format": "{capacity} · {status}"
    },
    {
      "type": "localip",
      "key": "󰩟  ip",
      "compact": true
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
