# Usage: _wt_remove_worktree <git_common_root> <worktree_path> [branch]
# Removes a worktree directory; deletes the local branch when given.
# git runs with -C <root> so removals keep working even when the current
# working directory was itself removed in an earlier iteration.
emulate -L zsh

local wt_root="$1" wt_path="$2" wt_branch="$3"

if git -C "$wt_root" worktree remove "$wt_path" --force 2>/dev/null; then
  print "   ✅ Removed from git"
else
  print "   ⚠️  Failed to remove from git, removing directory..."
fi
if [[ -d "$wt_path" ]]; then
  rm -rf "$wt_path"
  print "   ✅ Removed directory"
fi
if [[ -n "$wt_branch" ]]; then
  if git -C "$wt_root" branch -D "$wt_branch" 2>/dev/null; then
    print "   🗑️  Deleted local branch: $wt_branch"
  else
    print "   ⚠️  Failed to delete branch (may not exist)"
  fi
fi