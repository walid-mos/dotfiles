# Prints "path|branch" for every worktree except the MAIN checkout — even
# when called from inside a worktree.
emulate -L zsh

local wt_main_root
wt_main_root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
wt_main_root="${wt_main_root:h}"
git worktree list --porcelain | awk -v root="$wt_main_root" '
  /^worktree / { path = substr($0, 10) }
  /^branch / {
    branch = substr($0, 8)
    sub(/^refs\/heads\//, "", branch)
    if (path != root) print path "|" branch
    path = ""; branch = ""
  }
'