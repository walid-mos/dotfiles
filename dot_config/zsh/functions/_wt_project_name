# Project name: basename from remote.origin.url, else MAIN checkout dir name
# (git-common-dir parent — NOT the current worktree, so `wt new` from inside
# a worktree still targets the right centralized directory).
emulate -L zsh

local wt_remote_url
wt_remote_url=$(git config --get remote.origin.url 2>/dev/null)
if [[ -n "$wt_remote_url" ]]; then
  print -r -- "${wt_remote_url:t:r}"
  return 0
fi

local wt_common_dir
wt_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
print -r -- "${wt_common_dir:h:t}"