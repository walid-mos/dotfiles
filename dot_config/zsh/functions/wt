#!/bin/zsh
# =============================================================================
# wt - centralized git worktree manager with lifecycle hooks
# =============================================================================
# Worktrees live in $WORKTREES_BASE as {project}-{branch}, one branch per
# directory. Integration with external tools (pi, herdr, container-sandbox)
# happens ONLY through hook ports - wt core knows nothing about them.
#
# PORTS: executable files in
#   ~/.config/wt/hooks/<event>/        (global, runs first)
#   <repo>/.config/wt/hooks/<event>/   (per project, runs after)
# are executed in lexical order with cwd set to the worktree and context env:
#   WT_EVENT WT_PROJECT WT_BRANCH WT_PATH WT_GIT_ROOT WORKTREES_BASE
#
# Events:
#   create  after `wt new`/`wt spawn` created the worktree
#   init    right before a session is launched
#   spawn   LAUNCHER port - the FIRST executable hook found is run and its
#           exit code is the result; no hooks found -> fallback: run `pi`
#   clean   after a worktree is removed (by `wt clean` or `wt prune`)
# =============================================================================

emulate -L zsh

: ${WORKTREES_BASE:="$HOME/development/worktrees"}
export WORKTREES_BASE

local wt_command="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$wt_command" in
  new)    _wt_new "$@" ;;
  spawn)  _wt_spawn "$@" ;;
  switch) _wt_switch "$@" ;;
  list)   _wt_list ;;
  status) _wt_status ;;
  clean)  _wt_clean "$@" ;;
  prune)  _wt_prune "$@" ;;
  help|--help|-h) _wt_help ;;
  *)
    print -u2 "❌ Unknown command: $wt_command"
    _wt_help
    return 1
    ;;
esac