# Usage: wt prune [-i|--interactive]
# Removes worktrees (and their local branches) whose upstream branch was
# deleted on the remote. Runs the same `clean` hooks as `wt clean`.
emulate -L zsh

local wt_interactive=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--interactive) wt_interactive=true ;;
    *) print -u2 "❌ Unknown argument: $1"; print -u2 "Usage: wt prune [--interactive|-i]"; return 1 ;;
  esac
  shift
done
_wt_require_repo || return 1
local wt_git_root
wt_git_root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1

print "🔍 Fetching with prune to update remote tracking..."
git fetch --prune
local wt_worktrees
wt_worktrees=$(_wt_worktrees) || return 1
[[ -n "$wt_worktrees" ]] || { print "📋 No worktrees found for this project"; return 0 }

local -a wt_gone=() wt_to_remove=()
local wt_path wt_branch wt_info
while IFS='|' read -r wt_path wt_branch; do
  [[ -n "$wt_branch" ]] || continue
  wt_info=$(git branch -vv | grep "^. $wt_branch " | grep ": gone]")
  [[ -n "$wt_info" ]] && wt_gone+=("${wt_branch}|${wt_path}")
done <<< "$wt_worktrees"
(( ${#wt_gone} )) || { print "✅ No worktrees to prune (all branches are up to date)"; return 0 }

print "🧹 Found ${#wt_gone} worktree(s) for deleted branches:"
for wt_info in "${wt_gone[@]}"; do
  print "  - ${wt_info%%|*}"
done
print ""

if [[ "$wt_interactive" == true ]]; then
  for wt_info in "${wt_gone[@]}"; do
    wt_branch="${wt_info%%|*}"
    _wt_confirm "Remove worktree for '$wt_branch'?" || { print "⏭️  Skipping '$wt_branch'"; print ""; continue }
    wt_to_remove+=("$wt_info")
  done
else
  _wt_confirm "Remove all ${#wt_gone} worktree(s) and their local branches?" \
    || { print "❌ Cancelled"; return 0 }
  wt_to_remove=("${wt_gone[@]}")
fi

for wt_info in "${wt_to_remove[@]}"; do
  wt_branch="${wt_info%%|*}"
  wt_path="${wt_info#*|}"
  print "🗑️  Removing worktree: $wt_branch"
  _wt_remove_worktree "$wt_git_root" "$wt_path" "$wt_branch"
  _wt_export_context clean "$wt_path" "$wt_branch"
  _wt_hooks clean "$wt_path" "$wt_branch" || return $?
done
wt_main_root="${wt_git_root:h}"
if ! [[ -d "$PWD" ]] && [[ -d "$wt_main_root" ]]; then
  cd "$wt_main_root"
  print "📂 cwd was removed — back in: $wt_main_root"
fi
print "✅ Prune complete!"