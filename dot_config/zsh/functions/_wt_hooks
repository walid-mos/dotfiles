# Usage: _wt_hooks <event> <worktree_path> [branch]
# Runs every executable hook for <event>: ~/.config/wt/hooks/<event>/ first,
# then <repo>/.config/wt/hooks/<event>/, lexical order, cwd = worktree.
# Hooks run in a subshell so the caller's cwd never moves. Stops at the first
# failing hook and returns its exit code.
emulate -L zsh

local wt_event="$1" wt_path="$2" wt_branch="$3"
local wt_hook wt_hooks_dir
local -a wt_hook_dirs
wt_hooks_dir="$HOME/.config/wt/hooks/$wt_event"
[[ -d "$wt_hooks_dir" ]] && wt_hook_dirs+=("$wt_hooks_dir")
wt_hooks_dir="${WT_GIT_ROOT-.}/.config/wt/hooks/$wt_event"
[[ -d "$wt_hooks_dir" ]] && wt_hook_dirs+=("$wt_hooks_dir")
(( ${#wt_hook_dirs} )) || return 0

for wt_hooks_dir in "${wt_hook_dirs[@]}"; do
  for wt_hook in "$wt_hooks_dir"/*(N); do
    [[ -x "$wt_hook" ]] || continue
    ( cd "$wt_path" 2>/dev/null; "$wt_hook" ) || return $?
  done
done