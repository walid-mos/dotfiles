# Usage: _wt_confirm <question>
# Y/n prompt defaulting to yes. Honors the caller's dynamic local
# wt_auto_yes: when set, always returns 0 (non-interactive -y mode).
emulate -L zsh

local wt_question="$1"
[[ -n "$wt_auto_yes" ]] && return 0
print -n "⚠️  ${wt_question} (Y/n): "
local wt_answer
read -r wt_answer
case "$wt_answer" in
  [Nn]|no) return 1 ;;
esac
return 0