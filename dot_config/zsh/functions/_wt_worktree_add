# Usage: _wt_worktree_add <branch> <worktree_path>
# Creates a worktree (and the branch when missing). No prompts - callers own
# the UX. Returns git's exit code.
emulate -L zsh

mkdir -p "$WORKTREES_BASE"
if git show-ref --verify --quiet "refs/heads/$1"; then
  git worktree add "$2" "$1"
else
  git worktree add -b "$1" "$2"
fi