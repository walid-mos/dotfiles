# Usage: wt switch [branch]
# Switches to a worktree; interactive fzf picker when no branch is given.
emulate -L zsh

local wt_target_branch="$1" wt_path wt_branch
_wt_require_repo || return 1
local wt_worktrees
wt_worktrees=$(_wt_worktrees) || return 1
if [[ -z "$wt_worktrees" ]]; then
  print -u2 "❌ No worktrees found for this project"
  print -u2 "💡 Create one with: wt new <branch-name>"
  return 1
fi

if [[ -n "$wt_target_branch" ]]; then
  while IFS='|' read -r wt_path wt_branch; do
    if [[ "$wt_branch" == "$wt_target_branch" ]]; then
      cd "$wt_path" 2>/dev/null || { print -u2 "❌ Failed to switch to worktree: $wt_path"; return 1 }
      print "✅ Switched to: $wt_path"
      return 0
    fi
  done <<< "$wt_worktrees"
  print -u2 "❌ No worktree found for branch: $wt_target_branch"
  print -u2 "Available branches:"
  while IFS='|' read -r wt_path wt_branch; do print -u2 "  - $wt_branch"; done <<< "$wt_worktrees"
  return 1
fi

_wt_require_fzf || return 1
local wt_current_dir="$PWD" wt_selected
wt_selected=$(print -r -- "$wt_worktrees" | while IFS='|' read -r wt_path wt_branch; do
  if [[ "$wt_path" == "$wt_current_dir" ]]; then
    print "✓ $wt_branch → $wt_path"
  else
    print "  $wt_branch → $wt_path"
  fi
done | fzf --prompt="Switch to worktree: " --height=40% --border \
  --header="Select worktree to switch to (↑↓ to navigate, Enter to select)" \
  --preview-window=hidden)
[[ -n "$wt_selected" ]] || { print -u2 "❌ No worktree selected"; return 1 }

local wt_target_path="${wt_selected##* → }"
cd "$wt_target_path" 2>/dev/null || { print -u2 "❌ Failed to switch to worktree: $wt_target_path"; return 1 }
print "✅ Switched to: $wt_target_path"