#!/bin/zsh
# Git fetch with prune and cleanup of branches gone from the remote.
# A gone branch with a linked worktree is offered removal through that worktree.

# Branch name checked out in the main worktree (first porcelain record).
_main_wt_branch() {
    git worktree list --porcelain |
    awk '/^worktree /{ if (main++) exit } /^branch /{ sub("refs/heads/", "", $2); print $2; exit }'
}

# Path of the linked worktree holding that branch (empty when none).
_wt_path_for_branch() {
    local branch="$1"
    git worktree list --porcelain |
    awk -v br="refs/heads/$branch" '
        /^worktree /{ p = substr($0, 10) }
        /^branch /  { b = $2 }
        /^$/        { if (b == br) print p; b = "" }
        END         { if (b == br) print p }
    '
}

# 0=deleted 1=failed 2=skipped 3=kept (declined, dirty or main worktree)
_delete_branch() {
    local branch="$1" wt_path
    wt_path=$(_wt_path_for_branch "$branch")

    if [ "$branch" = "$(_main_wt_branch)" ]; then
        echo "Skipping '$branch' (checked out in the main worktree)"
        return 2
    fi

    if [ -z "$wt_path" ]; then
        if git branch -D "$branch" >/dev/null 2>&1; then
            echo "Deleted branch: $branch"
            return 0
        fi
        echo "Failed to delete branch: $branch"
        return 1
    fi

    echo "Branch '$branch' is checked out in worktree: $wt_path"
    echo "Removing it also deletes ignored files there (.env, cache dirs, ...)."
    echo -n "Remove worktree and delete branch? (y/n): "
    read -r wt_answer
    case $wt_answer in
        [Yy]|yes)
            if [ -n "$(git -C "$wt_path" status --porcelain)" ]; then
                echo "   '$wt_path' has uncommitted or untracked changes, kept."
                echo "   Clean it up first, or force with:"
                echo "   git worktree remove --force $wt_path && git branch -D $branch"
                return 3
            fi
            git worktree remove "$wt_path"
            if [ $? -ne 0 ]; then
                echo "   Failed to remove worktree: $wt_path"
                return 1
            fi
            git branch -D "$branch" >/dev/null 2>&1
            if [ $? -ne 0 ]; then
                echo "   Worktree removed, branch deletion failed: $branch"
                return 1
            fi
            echo "Removed worktree and deleted branch: $branch"
            return 0
            ;;
        *)
            echo "   Kept. Manual cleanup later:"
            echo "     git worktree remove $wt_path && git branch -D $branch"
            return 3
            ;;
    esac
}

local interactive_mode=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --interactive|-i)
            interactive_mode=true
            shift
            ;;
        --help|-h)
            echo "Usage: gf [--interactive|-i]"
            echo "  --interactive, -i    Ask confirmation for each branch individually"
            echo "  --help, -h          Show this help message"
            echo ""
            echo "A gone branch still checked out in a worktree: gf offers to remove"
            echo "the worktree first, then the branch. Ignored files (.env, ...) go too."
            return 0
            ;;
        *)
            echo "Error: Unknown argument '$1'"
            echo "Usage: gf [--interactive|-i]"
            return 1
            ;;
    esac
done

echo "Fetching with prune..."
git fetch --prune
echo "\nCleaning up branches that are gone on remote..."

local gone_branches=$(git branch -vv | grep ": gone]" | awk '{gsub(/^[*+] */, ""); print $1}')

if [ -z "$gone_branches" ]; then
    echo "No branches to clean up"
    return 0
fi

# Convert to array for easier handling
local -a branch_array
branch_array=(${(f)gone_branches})
local branch_count=${#branch_array[@]}

echo "Found $branch_count branch(es) to delete:"
printf "  - %s\n" "${branch_array[@]}"
echo

if [ "$interactive_mode" = true ]; then
    # Interactive mode: ask for each branch
    for branch in "${branch_array[@]}"; do
        while true; do
            echo -n "Delete branch '$branch'? (y/n/a/q): "
            read -r response
            case $response in
                [Yy]|yes)
                    _delete_branch "$branch"
                    break
                    ;;
                [Nn]|no)
                    echo "Skipping '$branch'"
                    break
                    ;;
                [Aa]|all)
                    echo "Deleting all remaining branches..."
                    for remaining_branch in "${branch_array[@]}"; do
                        _delete_branch "$remaining_branch"
                    done
                    break 2
                    ;;
                [Qq]|quit)
                    echo "Cancelled"
                    return 0
                    ;;
                *)
                    echo "Please answer y(es), n(o), a(ll), or q(uit)"
                    ;;
            esac
        done
    done
else
    # Default mode: global confirmation (default to Y)
    echo -n "Delete all $branch_count branch(es)? (Y/n): "
    read -r response
    case $response in
        [Nn]|no)
            echo "Cancelled"
            return 0
            ;;
        *)
            # Default to yes for empty input or 'y'/'yes'
            for branch in "${branch_array[@]}"; do
                _delete_branch "$branch"
            done
            ;;
    esac
fi
