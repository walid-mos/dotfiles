emulate -L zsh

_gf_main_worktree_branch() {
  git worktree list --porcelain |
    awk '/^worktree /{ if (main++) exit } /^branch /{ sub("refs/heads/", "", $2); print $2; exit }'
}

_gf_worktree_path_for_branch() {
  git worktree list --porcelain |
    awk -v br="refs/heads/$1" '
      /^worktree /{ p = substr($0, 10) }
      /^branch /  { b = $2 }
      /^$/        { if (b == br) print p; b = "" }
      END         { if (b == br) print p }
    '
}

_gf_lost_commit_count() {
  local branch=$1 ref
  local -a not_refs=()
  for ref in ${(f)"$(git for-each-ref --format='%(refname)' refs/heads refs/remotes)"}; do
    [[ $ref == "refs/heads/$branch" ]] && continue
    not_refs+=("^$ref")
  done
  if (( ${#not_refs} == 0 )); then
    git rev-list --count "refs/heads/$branch"
  else
    git rev-list --count "refs/heads/$branch" "${not_refs[@]}"
  fi
}

_gf_worktree_reason() {
  local branch=$1 worktree_path=$2 lost
  local -a parts=()
  if [[ -n $(git -C $worktree_path status --porcelain 2>/dev/null) ]]; then
    parts+=("uncommitted or untracked files")
  fi
  lost=$(_gf_lost_commit_count $branch)
  (( ${lost:-0} != 0 )) && parts+=("$lost commit(s) exist only on this branch")
  print -r -- ${(j:; :)parts}
}

_gf_remove_worktree() {
  local branch=$1 worktree_path=$2
  if ! git worktree remove --force $worktree_path; then
    echo "   Failed to remove worktree: $worktree_path"
    echo "   Kept. Manual cleanup later:"
    echo "     git worktree remove --force $worktree_path && git branch -D $branch"
    return 1
  fi
  if ! git branch -D $branch > /dev/null 2>&1; then
    echo "   Worktree removed, branch deletion failed: $branch"
    return 1
  fi
  echo "Removed worktree and deleted branch: $branch"
}

_gf_delete_branch() {
  local branch=$1 worktree_path=$2
  if [[ $branch == "$(_gf_main_worktree_branch)" ]]; then
    echo "Skipping '$branch' (checked out in the main worktree)"
    return 2
  fi
  [[ -z $worktree_path ]] && worktree_path=$(_gf_worktree_path_for_branch $branch)
  if [[ -n $worktree_path ]]; then
    _gf_remove_worktree $branch $worktree_path
    return
  fi
  if git branch -D $branch > /dev/null 2>&1; then
    echo "Deleted branch: $branch"
    return 0
  fi
  echo "Failed to delete branch: $branch"
  return 1
}

_gf_delete_branches() {
  local -a branches=("$@") risky_branches=() risky_paths=() risky_reasons=()
  local branch worktree_path reason answer index
  for branch in "$branches[@]"; do
    if [[ $branch == "$(_gf_main_worktree_branch)" ]]; then
      echo "Skipping '$branch' (checked out in the main worktree)"
      continue
    fi
    worktree_path=$(_gf_worktree_path_for_branch $branch)
    if [[ -n $worktree_path ]]; then
      reason=$(_gf_worktree_reason $branch $worktree_path)
      if [[ -n $reason ]]; then
        risky_branches+=$branch
        risky_paths+=$worktree_path
        risky_reasons+=$reason
        continue
      fi
      _gf_remove_worktree $branch $worktree_path
      continue
    fi
    if git branch -D $branch > /dev/null 2>&1; then
      echo "Deleted branch: $branch"
    else
      echo "Failed to delete branch: $branch"
    fi
  done
  (( ${#risky_branches} == 0 )) && return 0

  echo
  echo "Worktrees with unpushed or uncommitted work:"
  for (( index = 1; index <= ${#risky_branches}; index++ )); do
    echo "  - '${risky_branches[index]}' at ${risky_paths[index]}: ${risky_reasons[index]}"
  done
  echo "Removing them also deletes ignored files there (.env, cache dirs, ...)."
  echo -n "Remove all ${#risky_branches} worktree(s) and delete their branches? (y/n): "
  read -r answer
  case $answer in
    [Yy]|yes)
      for (( index = 1; index <= ${#risky_branches}; index++ )); do
        _gf_remove_worktree ${risky_branches[index]} ${risky_paths[index]}
      done
      ;;
    *)
      echo "Kept. Manual cleanup later:"
      for (( index = 1; index <= ${#risky_branches}; index++ )); do
        echo "  git worktree remove --force ${risky_paths[index]} && git branch -D ${risky_branches[index]}"
      done
      ;;
  esac
}

_gf_confirm_each() {
  local -a branches=("$@")
  local -i index
  local branch worktree_path reason response
  for (( index = 1; index <= $#branches; index++ )); do
    branch=${branches[index]}
    if [[ $branch == "$(_gf_main_worktree_branch)" ]]; then
      echo "Skipping '$branch' (checked out in the main worktree)"
      continue
    fi
    worktree_path=$(_gf_worktree_path_for_branch $branch)
    reason=$(_gf_worktree_reason $branch $worktree_path)
    if [[ -n $worktree_path && -n $reason ]]; then
      echo "Branch '$branch' is checked out in worktree: $worktree_path"
      echo "   $reason"
      echo "Removing it also deletes ignored files there (.env, cache dirs, ...)."
      echo -n "Remove worktree and delete branch? (y/n/a/q): "
    elif [[ -n $worktree_path ]]; then
      echo -n "Delete branch '$branch' (checked out in worktree: $worktree_path)? (y/n/a/q): "
    elif [[ -n $reason ]]; then
      echo "Branch '$branch': $reason"
      echo -n "Delete branch anyway? (y/n/a/q): "
    else
      echo -n "Delete branch '$branch'? (y/n/a/q): "
    fi
    read -r response || { echo; echo "Cancelled"; return }
    case $response in
      [Yy]|yes) _gf_delete_branch $branch $worktree_path ;;
      [Nn]|no) echo "Skipping '$branch'" ;;
      [Aa]|all)
        echo "Deleting all remaining branches..."
        _gf_delete_branches "${(@)branches[index,-1]}"
        return
        ;;
      [Qq]|quit)
        echo "Cancelled"
        return
        ;;
      *)
        echo "Please answer y(es), n(o), a(ll), or q(uit)"
        (( index-- ))
        ;;
    esac
  done
}

_gf_confirm_all() {
  local response
  echo -n "Delete all $# branch(es)? (Y/n): "
  read -r response
  case $response in
    [Nn]|no) echo "Cancelled" ;;
    *) _gf_delete_branches "$@" ;;
  esac
}

_gf_usage() {
  echo "Usage: gf [--interactive|-i]"
  echo "  --interactive, -i    Ask confirmation for each branch individually"
  echo "  --help, -h          Show this help message"
  echo ""
  echo "A gone branch with no worktree is deleted outright. A gone branch"
  echo "checked out in a linked worktree is removed together with that worktree;"
  echo "if uncommitted or unshared commits remain, everything is held back and"
  echo "confirmed once, no matter how many worktrees are involved."
}

local -i interactive=0
while (( $# )); do
  case $1 in
    --interactive|-i) interactive=1 ;;
    --help|-h)
      _gf_usage
      return 0
      ;;
    *)
      echo "Error: Unknown argument '$1'"
      echo "Usage: gf [--interactive|-i]"
      return 1
      ;;
  esac
  shift
done

echo "Fetching with prune..."
git fetch --prune
echo "\nCleaning up branches that are gone on remote..."

local -a gone_branches
gone_branches=(${(f)"$(git branch -vv | grep ': gone]' | awk '{gsub(/^[*+] */, ""); print $1}')"})
if (( $#gone_branches == 0 )); then
  echo "No branches to clean up"
  return 0
fi

echo "Found $#gone_branches branch(es) to delete:"
printf "  - %s\n" "${gone_branches[@]}"
echo

if (( interactive )); then
  _gf_confirm_each "${gone_branches[@]}"
else
  _gf_confirm_all "${gone_branches[@]}"
fi
