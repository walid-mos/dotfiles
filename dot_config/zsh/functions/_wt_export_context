# Usage: _wt_export_context <event> <worktree_path> [branch]
# Exports the hook context (WT_*) used by every hook port.
emulate -L zsh

WT_EVENT="$1"
WT_PATH="$2"
WT_BRANCH="$3"
WT_PROJECT="$(_wt_project_name)" || return 1
WT_GIT_ROOT=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
WT_GIT_ROOT="${WT_GIT_ROOT:h}"
export WT_EVENT WT_PATH WT_BRANCH WT_PROJECT WT_GIT_ROOT WORKTREES_BASE