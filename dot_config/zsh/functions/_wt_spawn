# Usage: wt spawn <branch>
# Ensures the worktree exists (no prompts), runs `init` hooks, then delegates
# the session to the `spawn` launcher port (first hook wins, fallback: pi).
emulate -L zsh

local wt_branch="$1"
[[ -n "$wt_branch" ]] || { print -u2 "❌ Branch name required"; print -u2 "Usage: wt spawn <branch-name>"; return 1 }
_wt_require_repo || return 1

local wt_path
wt_path=$(_wt_worktree_path "$wt_branch") || return 1
if [[ ! -d "$wt_path" ]]; then
  print "📦 Creating worktree: $wt_path"
  _wt_worktree_add "$wt_branch" "$wt_path" || { print -u2 "❌ Failed to create worktree"; return 1 }
  _wt_export_context create "$wt_path" "$wt_branch"
  _wt_hooks create "$wt_path" "$wt_branch" || return $?
fi

_wt_export_context init "$wt_path" "$wt_branch"
_wt_hooks init "$wt_path" "$wt_branch" || return $?

_wt_export_context spawn "$wt_path" "$wt_branch"
_wt_launch "$wt_path"