# Usage: wt list
emulate -L zsh

_wt_require_repo || return 1
local wt_worktrees
wt_worktrees=$(_wt_worktrees) || return 1
if [[ -z "$wt_worktrees" ]]; then
  print "📋 No worktrees found for this project"
  print "💡 Create one with: wt new <branch-name>"
  return 0
fi

print "📦 Project: $(_wt_project_name)"
print ""
print "🌿 Worktrees:"
local wt_current_dir="$PWD" wt_path wt_branch
while IFS='|' read -r wt_path wt_branch; do
  if [[ "$wt_path" == "$wt_current_dir" ]]; then
    print "  ✓ $wt_branch"
  else
    print "    $wt_branch"
  fi
  print "      📂 $wt_path"
done <<< "$wt_worktrees"