# Usage: wt new <branch> [-y|--yes]
# Creates a worktree for <branch> (branch created from HEAD when missing) and
# switches to it. Existing worktree -> just switches. Runs `create` hooks.
emulate -L zsh

local wt_branch wt_auto_yes
local -a wt_opts
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes) wt_auto_yes=yes ;;
    -*) print -u2 "❌ Unknown option: $1"; print -u2 "Usage: wt new <branch-name> [-y|--yes]"; return 1 ;;
    *) wt_branch="$1" ;;
  esac
  shift
done
[[ -n "$wt_branch" ]] || { print -u2 "❌ Branch name required"; print -u2 "Usage: wt new <branch-name> [-y|--yes]"; return 1 }
_wt_require_repo || return 1

local wt_path
wt_path=$(_wt_worktree_path "$wt_branch") || return 1
if [[ -d "$wt_path" ]]; then
  _wt_confirm "📂 Worktree already exists at $wt_path — navigate to it?" || return 0
  cd "$wt_path" 2>/dev/null || { print -u2 "❌ Failed to switch to worktree: $wt_path"; return 1 }
  print "✅ Switched to worktree: $wt_path"
  return 0
fi

print "📦 Project: $(_wt_project_name)"
print "🌿 Branch: $wt_branch"
print "📂 Path: $wt_path"
if ! git show-ref --verify --quiet "refs/heads/$wt_branch"; then
  _wt_confirm "📝 Branch '$wt_branch' does not exist — create it from current HEAD?" \
    || { print "❌ Operation cancelled"; return 0 }
fi
_wt_worktree_add "$wt_branch" "$wt_path" || { print -u2 "❌ Failed to create worktree"; return 1 }

_wt_export_context create "$wt_path" "$wt_branch"
_wt_hooks create "$wt_path" "$wt_branch" || return $?

cd "$wt_path" || { print -u2 "⚠️  Worktree created but failed to switch to: $wt_path"; return 1 }
print ""
print "✅ Worktree created — you are now in: $wt_path"