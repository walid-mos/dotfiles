# Usage: _wt_launch <worktree_path>
# Launcher port for `wt spawn`: runs the FIRST executable hook found in
# ~/.config/wt/hooks/spawn/ then <repo>/.config/wt/hooks/spawn/, with cwd set
# to the worktree. Its exit code is the result. No hook at all -> fallback
# launcher: `pi` in the worktree.
emulate -L zsh

local wt_path="$1" wt_hook wt_hooks_dir
local -a wt_hook_dirs
wt_hooks_dir="$HOME/.config/wt/hooks/spawn"
[[ -d "$wt_hooks_dir" ]] && wt_hook_dirs+=("$wt_hooks_dir")
wt_hooks_dir="${WT_GIT_ROOT-.}/.config/wt/hooks/spawn"
[[ -d "$wt_hooks_dir" ]] && wt_hook_dirs+=("$wt_hooks_dir")

for wt_hooks_dir in "${wt_hook_dirs[@]}"; do
  for wt_hook in "$wt_hooks_dir"/*(N); do
    [[ -x "$wt_hook" ]] || continue
    cd "$wt_path" || return 1
    "$wt_hook"
    return $?
  done
done

if ! command -v pi >/dev/null 2>&1; then
  print -u2 "❌ No spawn hook found and pi is not installed"
  return 1
fi
cd "$wt_path" || return 1
pi