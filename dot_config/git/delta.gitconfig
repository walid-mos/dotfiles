# delta : diffs git en couleur. syntax-theme=ansi → suit la palette du terminal (Herdr),
# clair/sombre détecté automatiquement.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = ansi
	navigate = true
	line-numbers = true
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
