{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabbar",
          "type": "row",
          "children": [
            {
              "id": "sidebar",
              "type": "block",
              "content": {
                "mod": "current-session"
              },
              "size": {
                "px": 380
              },
              "min": 0,
              "max": 380
            },
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              }
            }
          ],
          "size": {
            "px": 46
          },
          "background": "chrome",
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "stage",
              "type": "stack",
              "active": "main",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "pot-chat",
                  "type": "block",
                  "content": {
                    "mod": "pots",
                    "props": {
                      "role": "chat"
                    }
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "agent-strip"
          },
          "size": {
            "px": 28
          }
        },
        {
          "id": "agent-notify-mount",
          "type": "block",
          "content": {
            "mod": "agent-notify"
          },
          "size": {
            "px": 0
          }
        },
        {
          "id": "naming-mount",
          "type": "block",
          "content": {
            "mod": "agent-naming"
          },
          "size": {
            "px": 0
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "pots",
      "type": "block",
      "content": {
        "mod": "pots"
      },
      "size": {
        "px": 400
      },
      "min": 44
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/main-notify.svg"
}
