autoload -Uz $XDG_CONFIG_HOME/zsh/functions/*(N:t)

# Stage order: compinit before the completers in tools, highlighting after every widget they define.
for module in $XDG_CONFIG_HOME/zsh/rc/{terminal,completion,tools,highlighting}/*.zsh(N); do
  source $module
done
unset module

source $XDG_CONFIG_HOME/zsh/aliases.zsh
[[ -r $XDG_CONFIG_HOME/zsh/local.zsh ]] && source $XDG_CONFIG_HOME/zsh/local.zsh
