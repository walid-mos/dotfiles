autoload -Uz $XDG_CONFIG_HOME/zsh/functions/*(N:t)

# Modules load alphabetically: 00-ghostty.zsh must come first, zz-syntax-highlighting.zsh last.
for module in $XDG_CONFIG_HOME/zsh/conf.d/*.zsh(N); do
  source $module
done
unset module

source $XDG_CONFIG_HOME/zsh/aliases.zsh
[[ -r $XDG_CONFIG_HOME/zsh/local.zsh ]] && source $XDG_CONFIG_HOME/zsh/local.zsh
