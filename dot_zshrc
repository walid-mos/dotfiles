# =============================================================================
# Zsh Runtime Config (.zshrc)
# =============================================================================
# Sourced by INTERACTIVE shells only. This file only orchestrates: everything
# lives in ~/.config/zsh/conf.d/*.zsh (numbered = deterministic load order),
# ~/.config/zsh/aliases and ~/.config/zsh/functions. Never append tool blocks
# here - add a numbered conf.d file instead.
# =============================================================================

# Autoload custom commands (fpath is set in .zshenv)
autoload -Uz ~/.config/zsh/functions/*(:t)

# Modular configuration. Only order-dependent files carry a number:
#   00- ghostty shell integration (must be first)
#   90- syntax highlighting (must be last)
# Everything else is order-independent and loads alphabetically.
for config in ~/.config/zsh/conf.d/*.zsh(N); do
  source "$config"
done

# Aliases - separate file for quick access (order-independent: aliases only)
source ~/.config/zsh/aliases

# Machine-local overrides - untracked, created on demand for per-machine
# extras (project ports, one-off env). This replaces bottom-of-file appends.
[[ -f ~/.config/zsh/local.zsh ]] && source ~/.config/zsh/local.zsh

# ASCII BOAT SHELL INTEGRATION START boat
boat() {
  current_file=$(mktemp)
  convo_file=$(mktemp)
  old_current_file=${BOAT_CURRENT_ID_FILE-}
  old_convo_file=${BOAT_CURRENT_CONVO_FILE-}
  export BOAT_CURRENT_ID_FILE="$current_file"
  export BOAT_CURRENT_CONVO_FILE="$convo_file"
  command "/Users/walid-mos/.ascii/bin/boat" "$@"
  boat_status=$?
  if [ "$boat_status" -eq 0 ]; then
    case "${1:-}" in
      new|start|fork)
        if [ -s "$current_file" ]; then
          current_id=$(tr -d '[:space:]' < "$current_file")
          if [ -n "$current_id" ]; then export BOAT_CURRENT_ID="$current_id"; fi
        fi
        ;;
    esac
    case "${1:-}" in
      prompt)
        if [ -s "$convo_file" ]; then
          IFS= read -r current_convo < "$convo_file" || current_convo=""
          if [ -n "$current_convo" ]; then export BOAT_CURRENT_CONVO="$current_convo"; fi
        fi
        ;;
    esac
  fi
  if [ -n "$old_current_file" ]; then export BOAT_CURRENT_ID_FILE="$old_current_file"; else unset BOAT_CURRENT_ID_FILE; fi
  if [ -n "$old_convo_file" ]; then export BOAT_CURRENT_CONVO_FILE="$old_convo_file"; else unset BOAT_CURRENT_CONVO_FILE; fi
  rm -f "$current_file" "$convo_file"
  return "$boat_status"
}
# ASCII BOAT SHELL INTEGRATION END boat
