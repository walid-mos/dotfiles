#!/bin/sh
# stdin = current target content, stdout = new target content.
# Project overlays come from chezmoi config data [data.clientProjects], which
# lives outside the repo: machine-local client projects never reach git, and no
# data key renders "null" (clean no-op merge).
overlay='{{ $cfg := index . "clientProjects" }}{{ if $cfg }}{{ index $cfg "skillsJson" | default "null" }}{{ else }}null{{ end }}'
jq --tab -s --argjson overlay "$overlay" '
	(.[0] // {"projects": {}})
	| .projects = ((.projects // {}) + ($overlay // {}))
'
