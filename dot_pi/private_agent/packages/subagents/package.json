{
  "name": "pi-subagents",
  "version": "0.75.0",
  "private": true,
  "description": "Pi extension for single-agent delegation and scripted multi-agent workflows",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./test/support/isolated-temp-root.mjs --test --test-timeout=60000 test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test --test-timeout=120000 test/integration/*.test.ts",
    "test:all": "pnpm run test:unit && pnpm run test:integration"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": ">=0.99.1",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "acorn": "8.18.0",
    "jiti": "2.7.0",
    "undici": "8.10.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
