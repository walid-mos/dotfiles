{
	"name": "pi-frontend-check",
	"version": "1.1.0-brave.1",
	"private": true,
	"description": "Pi extension: review and test JS frontends headlessly — open dev-server pages in Playwright Chromium, interact with them, capture screenshots the model can see, and collect console/network errors.",
	"keywords": [
		"extension",
		"frontend",
		"headless",
		"pi",
		"pi-coding-agent",
		"pi-package",
		"playwright",
		"screenshots",
		"testing"
	],
	"homepage": "https://github.com/sebaxzero/pi-frontend-check",
	"bugs": {
		"url": "https://github.com/sebaxzero/pi-frontend-check/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sebaxzero/pi-frontend-check.git"
	},
	"type": "module",
	"scripts": {
		"lint": "oxlint",
		"format:check": "oxfmt --check extensions scripts oxfmt.config.ts oxlint.config.ts",
		"type-check": "tsc --noEmit",
		"test": "node --test 'tests/*.test.ts'",
		"test:browser": "node --test 'tests/browser/*.test.ts'"
	},
	"dependencies": {
		"playwright-core": "1.64.0-alpha-2026-10-02"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@nextnode-solutions/standards": "^1.24.0",
		"@types/node": "^24.13.3",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"typebox": "1.3.7",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=24"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
