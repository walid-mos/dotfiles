# =============================================================================
# Zsh Environment (.zshenv)
# =============================================================================
# Sourced by EVERY zsh invocation (login, interactive, scripts, agent hooks).
# Only environment: XDG dirs, PATH, tool behavior. No interactive-only code.
# =============================================================================

# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# Tool behavior
export DOCKER_BUILDKIT=1
export TURBO_TELEMETRY_DISABLED=1
# colima: pin to the XDG root - the brew service (launchd, no XDG_CONFIG_HOME) reaches the
# same VM through the ~/.colima symlink, and COLIMA_HOME silences the legacy-root warnings.
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

# `open` routing shim - PREPENDED: every zsh session (interactive or not) must
# resolve `open` to the SSH-aware rule in ~/.config/shims. Curated dir (only
# files we manage), unlike ~/.local/bin below - installers can never pollute
# it, which is what the never-prepend rule protects against.
case ":$PATH:" in
  *":$HOME/.config/shims:"*) ;;
  *) export PATH="$HOME/.config/shims:$PATH" ;;
esac

# User-local binaries (herdr, cua-driver, ...) - APPENDED, never prepended.
# Installers (Hermes Agent, cua) drop shims here (node, npm, npx, hermes) that
# would otherwise shadow the real toolchain (pnpm's node, brew's hermes).
# Appending keeps them reachable without ever winning resolution.
# Python precedence lives in .zprofile: /etc/zprofile's path_helper prepends
# /usr/bin after this file, so anything set here loses to /usr/bin/python3.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$PATH:$HOME/.local/bin" ;;
esac

# Custom functions (autoloaded in .zshrc)
fpath=("$HOME/.config/zsh/functions" $fpath)

# Rust (when installed via rustup)
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# =============================================================================
# Secrets (API keys, tokens) - untracked file, NEVER committed.
# Sourced here so non-interactive shells (hooks, scripts) see them too.
# Scaffolding + permissions: bootstrap/configure.sh (configure_zsh_secrets).
# =============================================================================
[[ -f "$XDG_CONFIG_HOME/zsh/secrets" ]] && source "$XDG_CONFIG_HOME/zsh/secrets"

