typeset -U path fpath

export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state

export HOMEBREW_PREFIX=/opt/homebrew
export PNPM_HOME=$HOME/Library/pnpm
# The brew colima launchd service has no XDG_CONFIG_HOME: ~/.colima links here so both reach one VM.
export COLIMA_HOME=$XDG_CONFIG_HOME/colima
export DOCKER_BUILDKIT=1
export TURBO_TELEMETRY_DISABLED=1
export MCP_UI_VIEWER=none

fpath=($XDG_CONFIG_HOME/zsh/functions $fpath)

source $XDG_CONFIG_HOME/zsh/env/path.zsh
[[ -r $XDG_CONFIG_HOME/zsh/secrets ]] && source $XDG_CONFIG_HOME/zsh/secrets
source $XDG_CONFIG_HOME/zsh/env/infisical.zsh
source $XDG_CONFIG_HOME/zsh/env/aws.zsh
