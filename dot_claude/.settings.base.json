{
  "autoMemoryEnabled": false,
  "theme": "auto",
  "tui": "fullscreen",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-attribution.sh"
          }
        ]
      }
    ]
  }
}
